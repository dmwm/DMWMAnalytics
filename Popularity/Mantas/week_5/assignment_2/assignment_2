#!/bin/bash

# ASSIGNMENT #2
# received    : 2016 02 29
# description :
#  using old dataframes in one case and new Go generated dataframes
#  in another train a classifier, verify prediction results and analyse
#  the impact of additional attributes in new dataframes


# data expressions: training 201501*-201509*, validation 2015100*
train_rx="dataframe(-20150[0-9]{3}){2}\.csv\.gz$"
valid_rx="dataframe(-201510(0[1-9]|1[0-3])){2}\.csv\.gz$"

# data directories
old_data_path=/data/srv/state/dcafpilot/analytics/old_data
new_data_path=/data/srv/state/dcafpilot/analytics/data

# headers to drop
drops="nusers,totcpu,rnaccess,rnusers,rtotcpu,nsites,s_0,s_1,s_2,s_3,s_4,wct"

# models to use
#classifiers=("AdaBoostClassifier" "BaggingClassifier" "DecisionTreeClassifier" "ExtraTreesClassifier" "GradientBoostingClassifier" "KNeighborsClassifier" "RandomForestClassifier" "RidgeClassifier" "SGDClassifier" "SVC" "xgboost")
classifiers=("AdaBoostClassifier" "BaggingClassifier" "DecisionTreeClassifier" "ExtraTreesClassifier" "GradientBoostingClassifier" "XGBClassifier")

scorer="tp,tn,fp,fn,tpr,tnr,fpr,fnr,accuracy,precision,recall,f1"

echo "Starting script..."

# load of path variables to use DCAFPilot functions
#. /data/srv/current/apps/DCAFPilot/etc/profile.d/init.sh


## PREPARATION OF DATA

find_files() {
    : '
    Usage:  find_files /path/to/data/ regex
    Output: file list suitable to use with merge_csv
    '
    path=$1 #data path
    re=$2 #regex condition 
    files=""
    for f in $(ls $path); do
        if [[ $f =~ $re ]]; then
            files="$path/$f,$files"
        fi
    done
    echo ${files::${#files}-1}
}

verify_structure() {
    : '
    Usage:  verify_structure prefix
    No output, checks if data is consistent to proceed to prediction
    '
    pref=$1 #prefix {old, new}
    verify_dfr --file1=${pref}_train.csv.gz --file2=${pref}_train_clf.csv.gz --drops=$drops
    verify_dfr --file1=${pref}_valid.csv.gz --file2=${pref}_valid_clf.csv.gz --drops=$drops
    head_diff=`./headers_diff ${pref}_train_clf.csv.gz ${pref}_valid_clf.csv.gz`
    if [ ! "${#head_diff}" -le 0 ]; then
        endl=$'\n'
        echo "[$pref] Error: different number of attributes. Difference:$endl$head_diff"
        exit 1
    fi
}

prep_data() {
    : '
    Usage: prep_data /path/to/data/ prefix
    Output: data preparation for prediction
    '
    echo "Preparing $2 data..."
    path=$1 #data path
    pref=$2 #prefix {old, new}
    tfiles=$(find_files $path $train_rx)
    vfiles=$(find_files $path $valid_rx)
    #echo "$2 training files: $tfiles"
    #echo "$2 validation files: $vfiles"
    #exit 0
    merge_csv --fin=$tfiles --fout=${pref}_train.csv.gz
    merge_csv --fin=$vfiles --fout=${pref}_valid.csv.gz
    drops_=`find_drops --file1=${pref}_train.csv.gz --file2=${pref}_valid.csv.gz --drops=$drops`
    transform_csv --fin=${pref}_train.csv.gz --fout=${pref}_train_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops_
    transform_csv --fin=${pref}_valid.csv.gz --fout=${pref}_valid_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops_
}

predict_and_verify() {
    : '
    Usage:  predict_and_verify prefix classifier
    Output: trains, predicts, verifies, writes score to file
    '
    echo "|`date +'%Y-%m-%d %T'`| Predicting and verifying $2 data..."
    clf=$1 #classifier
    pref=$2 #prefix
    model --learner=$clf --idcol=id --target=target --train-file="${pref}_train_clf.csv.gz" --scaler=StandardScaler --newdata="${pref}_valid_clf.csv.gz" --predict="${pref}_${clf}.txt" --split=0
    check_prediction --fin="${pref}_valid_clf.csv.gz" --fpred="${pref}_${clf}.txt" --scorer=$scorer > "${pref}_${clf}.pred"
    rm "${pref}_${clf}.txt"
}

prep_data $old_data_path old
prep_data $new_data_path new
verify_structure old
verify_structure new
if [ ! -z "$classifiers" ]; then
    for clf in "${classifiers[@]}"; do
        predict_and_verify $clf old
        predict_and_verify $clf new
    done
elif [ ! -z "$classifier" ]; then
    predict_and_verify $classifier old
    predict_and_verify $classifier new
fi
