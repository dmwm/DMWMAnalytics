#!/usr/bin/env python
#-*- coding: utf-8 -*-

from __future__ import print_function

__author__ = "Mantas Briliauskas"

# local modules
from reporter import Reporter

def gen_report():
    repmgr = Reporter()
    #report setup
    path  = "."
    fout  = "report.txt"
    fbeg1 = "old_"
    fbeg2 = "new_"
    fend  = ".pred"
    rtit  = "Week 5 Assignment 2"
    desc  = "Description     : train classifiers on old and new data, "
    desc += ", predict and verify the results\n"
    desc += "Training data   : old and new, 2015 01-09\n"
    desc += "Validation data : old and new, first week of 2015 10"
    tit1  = "Old data"
    tit2  = "New data"
    #report generation
    repmgr.open(fout)
    repmgr.write_section(rtit, desc)
    repmgr.write_table(path, fbeg=fbeg1, fend=fend, title=tit1)
    repmgr.write_table(path, fbeg=fbeg2, fend=fend, title=tit2)
    repmgr.close()

def main():
    gen_report()

if __name__ == '__main__':
    main()
