#!/bin/bash
#-*- coding: utf-8 -*-

# ASSIGNMENT #1
# received    : 2016 02 29
# description :
#  using 5 classifiers and 2015 training data
#  predict 2016 labels and verify


# training 20150101-20151231, validation 20160101-20160229
train_rx="dataframe(-2015[0-9]{4}){2}\.csv\.gz$"
valid_rx="dataframe(-20160[1-2][0-9]{2}){2}\.csv\.gz$"

# data directory
data_path=/data/srv/state/dcafpilot/analytics/data

# list atrributes to be dropped due to their bias
drops="nusers,totcpu,rnaccess,rnusers,rtotcpu,nsites,s_0,s_1,s_2,s_3,s_4,wct"

# classifiers
declare -a models=('AdaBoostClassifier' 'BaggingClassifier'
    'DecisionTreeClassifier' 'RandomForestClassifier' 'KNeighborsClassifier')
#models=('vw' 'xgboost')

# xgboost config
train="train_clf.csv.gz"
ndata="valid_clf.csv.gz"
trainxgb=`ls $train | awk '{split($1,a,"."); print ""a[1]".libsvm"}'`
ndataxgb=`ls $ndata | awk '{split($1,a,"."); print ""a[1]".libsvm"}'`
ndatavw=`ls $ndata | awk '{split($1,a,"."); print ""a[1]".vw"}'`
ndataids=`ls $ndata | awk '{split($1,a,"."); print ""a[1]".ids"}'`
cat > /tmp/xgboost.conf << EOF
# General Parameters, see comment for each definition
# for more info: https://github.com/tqchen/xgboost/wiki/Parameters
#
# choose the booster, can be gbtree or gblinear
booster = gbtree
# choose logistic regression loss function for binary classification
objective = binary:logistic
# Tree Booster Parameters
# step size shrinkage
eta = 0.1
# minimum loss reduction required to make a further partition
gamma = 1.0
# minimum sum of instance weight(hessian) needed in a child
min_child_weight = 1
# maximum depth of a tree
max_depth = 6
# Task Parameters
# the number of round to do boosting
num_round = 20
# 0 means do not save any model except the final round model
save_period = 0
# The path of training data
data = "$trainxgb"
# evaluate on training data as well each round
eval_train = 1
eval_metric = "logloss"
eval_metric = "auc"
eval_metric = "error"
eval_metric = "rmse"
# The path of test data
test:data = "$ndataxgb"
EOF

echo "Starting script..."

# load of path variables to use DCAFPilot functions
. /data/srv/current/apps/DCAFPilot/etc/profile.d/init.sh


## PREPARATION OF DATA

# training data
echo "Merging training data..."
files=""
for fn in $(ls $data_path); do
    if [[ $fn =~ $train_rx ]]; then
        files="$data_path/$fn,$files"
    fi
done
files=${files::${#files}-1}
#merge_csv --fin=$files --fout=train.csv.gz
echo "Transforming training data..."
drops_=`find_drops --file1=train.csv.gz --file2=valid.csv.gz --drops=$drops`
#transform_csv --fin=train.csv.gz --fout=train_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops_

# validation data
echo "Merging validation data..."
files=""
for fn in $(ls $data_path); do
    if [[ $fn =~ $valid_rx ]]; then
        files="$data_path/$fn,$files"
    fi
done
files=${files::${#files}-1}
#merge_csv --fin=$files --fout=valid.csv.gz
echo "Transforming validation data..."
drops_=`find_drops --file1=train_clf.csv.gz --file2=valid.csv.gz --drops=$drops`
#transform_csv --fin=valid.csv.gz --fout=valid_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops_

# explicitly check for difference in headers
_diff=`./headers_diff train_clf.csv.gz valid_clf.csv.gz`
if [ ! "${#_diff}" -le 0 ]; then
    endl=$'\n'
    echo "Error: different number of attributes. Difference:$endl$_diff"
    exit 1
fi

## PREDICTION

# train model and validate
for m in "${models[@]}"; do
    echo "|`date +'%Y-%m-%d %T'`| Running $m..."
    if [ "$m" == "vw" ]; then
        runvw train_clf.csv.gz valid_clf.csv.gz
        mv vwpreds.csv ${m}.txt
    elif [ "$m" == "xgboost" ]; then
        runxgboost train_clf.csv.gz valid_clf.csv.gz ${XGBOOST_CONFIG:-"/tmp/xgboost.conf"}
        mv xgpreds.csv ${m}.txt
    else
        model --learner=$m --idcol=id --target=target --train-file=train_clf.csv.gz --scaler=StandardScaler --newdata=valid_clf.csv.gz --predict=$m.txt --split=0
    fi
    check_prediction --fin=valid_clf.csv.gz --fpred=$m.txt --scorer=tp,tn,fp,fn,accuracy,precision,recall,f1 > $m.pred
done
