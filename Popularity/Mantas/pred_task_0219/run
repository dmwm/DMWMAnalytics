#!/bin/bash
# Script to train dataset popularity classifier
# using functions from DCAFPilot project

# train data 20150701-20151231, validation 20160101-20160229
TRAIN_RX="dataframe(-2015(0[7-9]|1[0-2][0-9]{2})){2}\.csv\.gz$"
VALID_RX="dataframe(-20160[1-2][0-9]{2}){2}\.csv\.gz$"
VALIDATE_START=20160101
VALIDATE_END=20160229
DATA_DIR=/data/srv/state/dcafpilot/analytics/data
#CLASSIFIER="RandomForestClassifier"
#CLASSIFIER="AdaBoostClassifier"
CLASSIFIER="BaggingClassifier"
#CLASSIFIER="DecisionTreeClassifier"
#CLASSIFIER="GradientBoostingClassifier"
OUTPUT="results.txt"

echo "Starting script..."

# init path variables to use DCAFPilot functions
. /data/srv/current/apps/DCAFPilot/etc/profile.d/init.sh


# prepare training data
echo "Merging training data..."
flist=""
for fname in $(ls $DATA_DIR); do
    if [[ $fname =~ $VALID_RX ]]; then
        flist="$DATA_DIR/$fname,$flist"
    fi
done
flist=${flist::${#flist}-1}
#merge_csv --fin=$flist --fout=train.csv.gz
echo "Transforming training data..."
drops="nusers,totcpu,rnaccess,rnusers,rtotcpu,nsites,s_0,s_1,s_2,s_3,s_4,wct"
#echo "  - Headers to drop in training set: $drops"
#transform_csv --fin=train.csv.gz --fout=train_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops


# prepare validation data
echo "Merging validation data..."
flist=""
for fname in $(ls $DATA_DIR); do
    if [[ $fname =~ $VALID_RX ]]; then
        flist="$DATA_DIR/$fname,$flist"
    fi
done
flist=${flist::${#flist}-1}
#merge_csv --fin=$flist --fout=valid.csv.gz
echo "Transforming validation data..."
drops=`find_drops --file1=valid.csv.gz --file2=train_clf.csv.gz --drops=$drops`
#echo "  - Headers to drop in validation set: $drops"
#transform_csv --fin=valid.csv.gz --fout=valid_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops


#====================== PREDICTION PART ==========================#

# train model and validate
echo "Training the model and predicting validation data..."
#model --learner=$CLASSIFIER --idcol=id --target=target --train-file=train_clf.csv.gz --scaler=StandardScaler --newdata=valid_clf.csv.gz --predict=pred.txt --split=0


# check prediction
echo "Scoring prediction..."
echo "Scores against validation data labels:" > $OUTPUT
#check_prediction --fin=valid_clf.csv.gz --fpred=pred.txt --scorer=accuracy,precision,recall,f1 >> $OUTPUT


# check prediction according PopDB
echo "Retrieving popular datasets from PopDB..."
echo "============================" >> $OUTPUT
echo "Scores against popDB data:" >> $OUTPUT
# if needed, seed MongoDB with fresh snapshot of DBS datasets
#dataframe --config=/data/srv/current/config/dcafpilot/dcaf.cfg --seed-cache
#pred2dataset --fin=pred.txt --fout=pred.predicted
echo "Removing duplicates..."
remove_duplicates --fin=pred.predicted --fout=pred.unique --colno=1 --verbose=1
#popular_datasets --start=$VALIDATE_START --stop=$VALIDATE_END > pred.popdb
verify_predictions --pred=pred.predicted --popdb=pred.popdb >> $OUTPUT
verify_predictions --pred=pred.unique --popdb=pred.popdb >> $OUTPUT.uniq


# output results
echo "====================="
echo "Done. Results :"
cat $OUTPUT
