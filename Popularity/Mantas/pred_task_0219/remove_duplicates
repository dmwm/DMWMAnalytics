"""
Removal of duplicates from structured file
"""

# futurize
from __future__ import print_function

__author__ = "Mantas Briliauskas"

# system modules
import optparse

# package modules
from DCAF.utils.utils import fopen

class OptionParser():
    def __init__(self):
        usage  = 'Usage: %prog [options]\n'
        usage += 'Description: removes dulicates and outputs unique rows'
        usage += 'Example: %prog --fin=pred.predicted --fout=pred.unique --colid=2'
        self.parser = optparse.OptionParser(usage=usage)
        self.parser.add_option("--fin", action="store", type="string",
            dest="fin", default="", help="Input file name")
        self.parser.add_option("--fout", action="store", type="string",
            dest="fout", default="", help="Output file file name")
        self.parser.add_option("--colno", action="store", type="int",
            dest="colno", default=0, help="Key column number, starting from 0, default = 0")
        self.parser.add_option("--sep", action="store", type="string",
            dest="sep", default=",", help="Columns separator, default = ','")
        self.parser.add_option("--verbose", action="store", type="int",
            dest="verbose", default=False, help="verbose mode, to output skipping lines set verbose > 1")
    def get_opt(self):
        return self.parser.parse_args()

def remove_duplicates(fin, fout, colno, sep, verbose):
    total   = 0
    unique  = 0
    lines   = []
    headers = []
    keys    = []
    ostream = open(fout, 'w')
    for line in open(fin, 'r').readlines():
        total += 1
        items = line.replace('\n', '').split(sep)
        if  not items[colno] in keys:
            ostream.write(line)
            keys.append(items[colno])
            unique += 1
        else:
            if  verbose > 1:
                print("Skipping: [%d]" % total, line)
    if  verbose:
        print("# total records  :", total)
        print("# duplicates     :", total-unique)
        print("# unique records :", unique)
    ostream.close()

def main():
    optmgr  = OptionParser()
    opts, _ = optmgr.get_opt()
    remove_duplicates(opts.fin, opts.fout, opts.colno, opts.sep, opts.verbose)

if __name__ == '__main__':
    main()

