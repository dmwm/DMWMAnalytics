# system modules
import os
import sys
import optparse
import datetime
import numpy as np
import datetime
from matplotlib import pyplot as plt
from matplotlib.dates import date2num

# package modules
from DCAF.utils.utils import fopen

class OptionParser(object):
    def __init__(self):
        self.parser = optparse.OptionParser()
        self.parser.add_option("--fin", action="store", type="string",
            dest="fin", default=".", help="Input file")
        self.parser.add_option("--fbeg", action="store", type="string",
            dest="fbeg", default="", help="Filter files by beginning")
        self.parser.add_option("--fend", action="store", type="string",
            dest="fend", default="", help="Filter files by ending")
    def options(self):
        return self.parser.parse_args()

def plot(data, headers):
    # TODO: grid, thicker lines, y limit -0.7 , +1.3
    if len(data) == 0:
        print("No data provided.")
        sys.exit(1)
    #x = [date2num(data[f][:,0]) for f in d
    l = np.array(data[data.iterkeys().next()])[:,0]
    x = [date2num(datetime.datetime.strptime(str(d), "%Y%m%d")) for d in l]
    for f in data.iterkeys():
        fig = plt.figure()
        spt = []
        for i in xrange(1, len(data[f][0])):
            y = [v[i] for v in data[f]]
            n = headers[i]
            g = fig.add_subplot(111)#len(data[f][0]),1,i)
            h, = g.plot_date(x=x, y=y, label=n,fmt="-")
            spt.append(h)
            g.set_xticks(x)
            g.set_xticklabels(l)
            yt = g.get_yticks()
            g.set_yticklabels(['{:3.2f}%'.format(v*100) for v in yt])
            g.set_title(f)
        fig.legend(spt, headers[1:])
        fig.savefig(f+'.png', bbox_inches='tight')

def read_data(fin, fbeg, fend):
    if  fin == ".":
        files = [f for f in os.listdir('.') if (len(fbeg) == 0 or f.startswith(fbeg))
                                        and (len(fend) == 0 or f.endswith(fend))]
    elif os.isdir(fin):
        files = [os.path.join(fin, f) for f in os.listdir(fin)
                                        if (len(fbeg) == 0 or f.startswith(fbeg))
                                        and (len(fend) == 0 or f.endswith(fend))]        
    elif os.path.isfile(fin):
        # if one file passed, its fn not checked
        files = [fin]
    else:
        print("Cannot produce file list, not a file or directory: \"%s\"" % fin)
        raise SystemExit
    data = {}
    headers = []
    for f in files:
        first = True
        for line in fopen(f).readlines():
            vals = line.strip(" \n\r").split(',')
            if  first:
                first = False
                if  not headers:
                    headers = vals
                elif headers != vals:
                    print("Original headers: %s" % headers)
                    print("Headers in %s: %s" % (f, vals))
                    sys.exit(1)
            else:
                fn  = os.path.basename(f)
                if  fn in data:
                    data[fn].append(vals)
                else:
                    data[fn] = [vals]
    return data, headers

def main():
    optmgr  = OptionParser()
    opts, _ = optmgr.options()
    data, h = read_data(opts.fin, opts.fbeg, opts.fend)
    plot(data, h)

if __name__ == '__main__':
    main()
