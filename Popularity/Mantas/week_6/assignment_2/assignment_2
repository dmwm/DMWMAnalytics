#!/bin/bash

# Week 6 Assignment 2
# received    : 2016 03 04
# description :
#   perform iterative weekly prediction, record results, and plot
#   initial training data   : 2015 last 9 months
#   initial validation data : first 2016 week
#   iterate : predict, record result, append week to training data
#             select new week to predict, retrain
#   until   : there is no data available

old_path=/data/srv/state/dcafpilot/analytics/old_data
new_path=/data/srv/state/dcafpilot/analytics/data
train_start=20150101
train_end=20151231
prefixes=("new")
finished="no" #iteration indicator
halt="no" #stop iteration flag
result_file="new_result_out.csv"
running_time_file="model_running.csv"

#classifiers=("AdaBoostClassifier" "BaggingClassifier" "DecisionTreeClassifier" "ExtraTreesClassifier" "GradientBoostingClassifier" "XGBClassifier")
classifiers=("KNeighborsClassifier" "RandomForestClassifier" "RidgeClassifier" "SGDClassifier")
drops="nusers,totcpu,rnaccess,rnusers,rtotcpu,nsites,s_0,s_1,s_2,s_3,s_4,wct"
scorer="tpr,tnr"

prepare_train_data() {
    # prepare_train_data {old,new}
    pref=$1
    echo "[$pref] Merging training data..."
    dol='$'
    path=`eval "echo \"${dol}${pref}_path\""`
    tfiles=`get_file_list $path $train_start $train_end`
    #echo "old training files   : $tfiles"
    merge_csv --fin=$tfiles --fout=${pref}_train.csv.gz
    # transformation is performed after validation data is known
    echo "[$pref] Finished merging training data."
}

get_file_list() {
    # running slowly because of constant python exec
    if [ $# -ne 3 ]; then echo "ERROR in get_file_list(). Given params: $@"; exit 1; fi
    path=$1
    start_date=$2
    end_date=$3
    files=""
    for f in `ls $path | egrep "\.csv\.gz$"`; do
        st=`echo $f | awk '{z=split($1,a,"/"); split(a[z],b,"."); n=split(b[1],c,"-"); print c[n-1]}'`
        en=`echo $f | awk '{z=split($1,a,"/"); split(a[z],b,"."); n=split(b[1],c,"-"); print c[n]}'`
        diff_st=`python -c "print $st-$start_date"`
        diff_en=`python -c "print $end_date-$en"`
        if [ $diff_st -ge 0 -a $diff_en -ge 0 ]; then
            files="$path/$f,$files"
        fi
    done
    if [ -n "$files" ]; then
        echo ${files::${#files}-1}
    else
        echo ""
    fi
}

column_count_check() {
    # column_count_check {old,new} train_clf_file valid_clf_file
    pref=$1
    f1=$2 #usually train_clf.csv.gz
    f2=$3 #usually valid_clf.csv.gz
    hdiff=`headers_diff $f1 $f2`
    if [ ! "${#hdiff}" -le 0 ]; then
        endl=$'\n'
        echo "[$pref] Error: different number of attributes. Difference:$endl$hdiff"
        exit 1
    fi
}

predict_and_write() {
    # predict_and_measure {old,new} package_classifier validation_start_date
    pref=$1
    clf=$2
    valid_start=$3
    model --learner=$clf --idcol=id --target=target --train-file="${pref}_train_clf.csv.gz" --scaler=StandardScaler --newdata="${pref}_valid_clf.csv.gz" --predict="${pref}_${clf}.txt" --split=0 --rt-out=$running_time_file
    out=`check_prediction --fin="${pref}_valid_clf.csv.gz" --fpred="${pref}_${clf}.txt" --scorer=$scorer --plain-output`
    # do not remove in case of ensembler
    #rm "${pref}_${clf}.txt"
    echo "[$pref] to csv: $out"
    echo "$pref,$clf,$valid_start,$out" >> "$result_file"
}

ensemble_and_write() {
    # ensemble_and_write (old|new) validation_file validation_start_date
    pref=$1
    fvalid=$2
    valid_start=$3
    echo "[$pref] Collecting ensemble..."
    ensemble_predictions --fbeg="${pref}_" --fout="${pref}_Ensemble.txt"
    out=`check_prediction --fin="${pref}_valid_clf.csv.gz" --fpred="${pref}_Ensemble.txt" --scorer=$scorer --plain-output`
    echo "[$pref] to csv: $out"
    echo "$pref,Ensemble,$valid_start,$out" >> "$result_file"
}

prepare_out_csv() {
    echo "dftype,clf,date,$scorer" > "$result_file"
}

##### MAIN ITERATION #####

iteration() {
    # usage : iteration {old,new} date_train_end
    # first predict and measure performance, then concat train and valid data
    pref=$1
    valid_start=`newdate --date=$2`
    dol='$'
    echo "[$pref] Separation date: $valid_start"
    valid_end=`newdate --date=$valid_start --step=12`
    path=`eval "echo \"${dol}${pref}_path\""`
    vfiles=`get_file_list $path $valid_start $valid_end`
    #echo "old training files   : $vfiles"
    if [[ ! -z "${vfiles// }" ]]; then
        # sanity check if one file selected
        if [[ $vfiles == *","* ]]; then
            echo "WARNING: more than one file selected: $vfiles"
            #finished="yes"
            #halt="yes"
            #exit 1
        fi
        echo "[$pref] Validation files: \"$vfiles\""
        echo "[$pref] Preparing validation, transforming all data..."
        merge_csv --fin=$vfiles --fout=${pref}_valid.csv.gz
        __drops=`find_drops --file1=${pref}_train.csv.gz --file2=${pref}_valid.csv.gz --drops=$drops`
        transform_csv --fin=${pref}_train.csv.gz --fout=${pref}_train_clf.csv.gz --target=naccess --target-thr=10 --drops=$__drops
        transform_csv --fin=${pref}_valid.csv.gz --fout=${pref}_valid_clf.csv.gz --target=naccess --target-thr=10 --drops=$__drops
        echo "[$pref] Data is prepared. Verifying..."
        verify_dfr --file1=${pref}_train.csv.gz --file2=${pref}_train_clf.csv.gz
        verify_dfr --file1=${pref}_valid.csv.gz --file2=${pref}_valid_clf.csv.gz
        column_count_check $pref ${pref}_train_clf.csv.gz ${pref}_valid_clf.csv.gz
        echo "[$pref] Predicting, writing data ..."
        for clf in "${classifiers[@]}"; do
            if [ "$halt" == "yes" ]; then
                exit 1
            fi
            predict_and_write $pref $clf $valid_start
        done
        ensemble_and_write $pref ${pref}_valid_clf.csv.gz $valid_start
    else
        finished="yes"
    fi
}


prepare_out_csv $result_file

for pref in "${prefixes[@]}"; do
    prepare_train_data $pref    
    finished="no"
    n=1
    __train_end=$train_end
    while [ "$finished" == "no" ]; do
        echo "===== Starting iteration << $n >> ===== |`date +'%Y-%m-%d %T'`|"
        iteration $pref $__train_end
        __train_end=`newdate --date=$__train_end --step=7`
        ((n+=1))
    done
    echo "[$pref] Work done."
done

