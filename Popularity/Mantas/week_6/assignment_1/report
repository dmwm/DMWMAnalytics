from __future__ import print_function

__author__ = "Mantas Briliauskas"

# local modules
from reporter import Reporter

def gen_report():
    repmgr = Reporter()
    #report setup
    path  = "."
    fout  = "report.txt"
    fbeg  = "" #all
    fend  = ".pred"
    rtit  = "Week 6 Assignment 1"
    desc  = "Description    : train and predict classifiers in combination with filtered dataframes\n"
    desc += "   Data filter : only datasets from tiers AOD, AODSIM, MINIAOD, MINIAODSIM, USER\n"
    desc += "   Subtask 1   : train on full data, predict on full data\n"
    desc += "   Subtask 2   : train on full data, predict on filtered data \n"
    desc += "   Subtask 3   : train on filtered data, predict on filtered data\n"
    desc += "Train period   : old, new 2015 second half\n"
    desc += "Valid period   : old, new 2016 first two weeks"
    
    #report generation
    repmgr.open(fout)
    repmgr.write_section(rtit, desc)
    repmgr.write_csv_table(path, fbeg=fbeg, fend=fend)
    repmgr.close()

def main():
    gen_report()

if __name__ == '__main__':
    main()
