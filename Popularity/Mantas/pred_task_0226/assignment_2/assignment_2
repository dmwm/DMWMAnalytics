# certificate check
if [ ! -f $X509_USER_PROXY ]; then
    echo "Certificate is not accessible. Checking for copy..."
    if [ -f $X509_USER_PROXY.bkp ]; then
        cp $X509_USER_PROXY.bkp $X509_USER_PROXY
        if [ -f $X509_USER_PROXY ]; then
            echo "Certificate recreated successfully."
        else
            echo "Certificate was unsuccessful to recreate. Exiting..."
            exit 1
        fi
    fi
fi

# data expressions: training 201501*-201503*, validation 201504*
train_rx="dataframe(-20150[1-3][0-9]{2}){2}\.csv\.gz$"
valid_rx="dataframe(-201504[0-9]{2}){2}\.csv\.gz$"

# data directories
old_data_path=/data/srv/state/dcafpilot/analytics/old_data
new_data_path=/data/srv/state/dcafpilot/analytics/data

# headers to drop
drops="nusers,totcpu,rnaccess,rnusers,rtotcpu,nsites,s_0,s_1,s_2,s_3,s_4,wct"
#drops="rel3_32,$drops" #for this specific case, training data has one attribute more then validation data withing Go-generated dataframes

# models to use
classifiers=("AdaBoostClassifier" "BaggingClassifier" "DecisionTreeClassifier" "ExtraTreesClassifier" "GradientBoostingClassifier" "KNeighborsClassifier" "RandomForestClassifier" "RidgeClassifier" "SGDClassifier" "SVC")

echo "Starting script..."

# load of path variables to use DCAFPilot functions
. /data/srv/current/apps/DCAFPilot/etc/profile.d/init.sh


## PREPARATION OF DATA

find_files() {
    : '
    Usage:  find_files /path/to/data/ regex
    Output: file list suitable to use with merge_csv
    '
    path=$1 #data path
    re=$2 #regex condition 
    files=""
    for f in $(ls $path); do
        if [[ $f =~ $re ]]; then
            files="$path/$f,$files"
        fi
    done
    echo ${files::${#files}-1}
}

verify_attributes() {
    : '
    Usage:  verify_attributes prefix
    No output, checks if data is consistent to proceed to prediction
    '
    pref=$1 #prefix {old, new}
    _diff=`./headers_diff ${pref}_train_clf.csv.gz ${pref}_valid_clf.csv.gz`
    if [ ! "${#_diff}" -le 0 ]; then
        endl=$'\n'
        echo "[$pref] Error: different number of attributes. Difference:$endl$_diff"
        exit 1
    fi
}

prep_data() {
    : '
    Usage: prep_data /path/to/data/ prefix
    Output: data preparation for prediction
    '
    echo "Preparing $2 data..."
    path=$1 #data path
    pref=$2 #prefix {old, new}
    tfiles=$(find_files $path $train_rx)
    vfiles=$(find_files $path $valid_rx)
    merge_csv --fin=$tfiles --fout=${pref}_train.csv.gz
    merge_csv --fin=$vfiles --fout=${pref}_valid.csv.gz
    drops=`find_drops --file1=${pref}_train.csv.gz --file2=${pref}_valid.csv.gz --drops=$drops`
    transform_csv --fin=${pref}_train.csv.gz --fout=${pref}_train_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops
    #drops=`find_drops --file1=${pref}_train_clf.csv.gz --file2=${pref}_valid.csv.gz --drops=$drops`
    transform_csv --fin=${pref}_valid.csv.gz --fout=${pref}_valid_clf.csv.gz --target=naccess --target-thr=10 --drops=$drops
}

predict_and_verify() {
    : '
    Usage:  predict_and_verify prefix classifier
    Output: trains, predicts, verifies, writes score to file
    '
    echo "|`date +'%Y-%m-%d %T'`| Predicting and verifying $2 data..."
    clf=$1 #classifier
    pref=$2 #prefix
    model --learner=$clf --idcol=id --target=target --train-file="${pref}_train_clf.csv.gz" --scaler=StandardScaler --newdata="${pref}_valid_clf.csv.gz" --predict="${pref}_${clf}.txt" --split=0
    check_prediction --fin="${pref}_valid_clf.csv.gz" --fpred="${pref}_${clf}.txt" --scorer=tp,tn,fp,fn,accuracy,precision,recall,f1 > "${pref}_${clf}.pred"
}

#prep_data $old_data_path old
#prep_data $new_data_path new
verify_attributes old
verify_attributes new
if [ ! -z "$classifiers" ]; then
    for clf in "${classifiers[@]}"; do
        predict_and_verify $clf old
        predict_and_verify $clf new
    done
elif [ ! -z "$classifier"]; then
    predict_and_verify $classifier old
    predict_and_verify $classifier new
fi
