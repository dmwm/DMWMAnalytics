from __future__ import print_function

__author__ = "Mantas Briliauskas"

# system modules
import sys
import gzip
import time
import optparse
import numpy as np

# package modules
from DCAF.utils.utils import fopen

class OptionParser(object):
    def __init__(self):
        self.parser = optparse.OptionParser()
        self.parser.add_option("--fin", action="store", type="string",
            default=None, dest="fin",
            help="File name to data to transform")
        self.parser.add_option("--fout", action="store", type="string",
            default=None, dest="fout", 
            help="File name to output transformation result")
        self.parser.add_option("--thres", action="store", type="int",
            default=None, dest="thres",
            help="Threshold value to identify columns and apply log transformation. When identifying, uses first 'fin' file line only. When this option is used, script _returns_ selected column indices list")
        self.parser.add_option("--all-cols", action="store_true",
            default=False, dest="toall",
            help="Option to transform all columns")
        self.parser.add_option("--cols", action="store", type="string",
            default=None, dest="cols",
            help="List of columns to apply log transformation. Please provide columns indexes starting from 0")
        self.parser.add_option("--sep", action="store", type="string",
            default=',', dest="sep",
            help="Data separator, default ','")
    def options(self):
        return self.parser.parse_args()

def to_number(val):
    try:
        return int(val)
    except:
        try:
            return float(val)
        except:
            return -1

def find_columns(line, thres, sep):
    vals = line.replace('\n', '').split(sep)
    cols = []
    for i in xrange(len(vals)):        
        if to_number(vals[i]) >= thres:
            cols.append(i)
    return cols

def apply_transformation(fin, fout, cols, headers, sep, logbias):
    start_time = time.time()
    istream = fopen(fin, 'r')
    ostream = fopen(fout, 'w')
    ostream.write(headers)
    istream.readline() #skip headers
    p = 0
    while True:
        p += 1
        if  p%200000 == 0:
            print("Working... %d done" % p)
        line = istream.readline()
        if  not line:
            break
        vals = line.replace('\n','').split(sep)
        for i in cols:
            vals[i] = np.log(to_number(vals[i])+logbias)
        out = sep.join(str(v) for v in vals) + '\n'
        ostream.write(out)
    elapsed_time = time.time() - start_time
    print("finished: elapsed time:", elapsed_time)

def get_headers_and_line(fname):
    with fopen(fname, 'r') as fstream:
        headers = fstream.readline()
        line    = fstream.readline().replace('\n', '')
    return headers, line

def log_transform(fin, fout, toall, cols, thres, sep, logbias):
    istream = fopen(fin, 'r')
    if  toall:
        headers, line = get_headers_and_line(fin)
        scols = find_columns(line, -sys.maxint - 1, sep)
        apply_transformation(fin, fout, scols, headers, sep, logbias)
        return
    if  cols is not None:
        headers, _ = get_headers_and_line(fin)
        scols = cols.split(sep)
        apply_transformation(fin, fout, scols, headers, sep, logbias)
        return
    if  thres is not None:
        headers, line = get_headers_and_line(fin)
        scols = find_columns(line, thres, sep)
        apply_transformation(fin, fout, scols, headers, sep, logbias)
        return
    """ No option selected """
    print("Unknown error occurred. Please consult the code")
    sys.exit(1)

def main():
    optmgr  = OptionParser()
    opts, _ = optmgr.options()
    if  opts.fin is None or opts.fout is None or\
            (opts.thres is None and not opts.toall and opts.cols is None):
        print("Usage: log_transform input_file output_file --mandatory_option")
        print("e.g. log_transform train.csv.gz train_.csv.gz --transform-all")
        print("e.g. log_transform train.csv.gz train_.csv.gz --thres=1000000")
        print("e.g. log_transform train.csv.gz train_.csv.gz --cols=0,4,9,15")
        sys.exit(1)
    log_transform(opts.fin, opts.fout, opts.toall, opts.cols, opts.thres, opts.sep, 2)

if __name__ == '__main__':
    main()
